{
  "name": "stackdojo",
  "version": "0.2.0",
  "description": "A gamified desktop practice app for a full modern stack, where every answer is actually run",
  "private": true,
  "license": "MIT",
  "author": "Forrest Lasiter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ForrestLasiter/stackdojo.git"
  },
  "homepage": "https://github.com/ForrestLasiter/stackdojo#readme",
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "app": "electron .",
    "test": "node scripts/verify.cjs",
    "smoke": "vite build && node scripts/smoke.cjs",
    "contrast": "node scripts/contrast.cjs",
    "typecheck": "tsc --noEmit",
    "dist": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "mingo": "^7.2.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native-web": "^0.21.4",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "codemirror": "^6.0.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.forrestlasiter.stackdojo",
    "productName": "StackDojo",
    "copyright": "Copyright (c) 2026 Forrest Lasiter",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "engine/**",
      "content/**",
      "dist/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "StackDojo",
      "artifactName": "StackDojo-Setup-${version}.exe"
    },
    "extraResources": [
      {
        "from": "node_modules/typescript/lib",
        "to": "tslib",
        "filter": [
          "lib*.d.ts"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ForrestLasiter",
        "repo": "stackdojo"
      }
    ]
  }
}
